const { createCanvas } = require('canvas');

class Executor {
  generatePatternGraphScreenshot(asset, prediction) {
    const width = 600;
    const height = 300;
    const canvas = createCanvas(width, height);
    const ctx = canvas.getContext('2d');

    ctx.fillStyle = '#131722';
    ctx.fillRect(0, 0, width, height);

    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 16px Arial';
    ctx.fillText(`AI Pattern Analysis Graph: ${asset}`, 20, 30);
    
    ctx.font = '12px Arial';
    ctx.fillStyle = '#00ffcc';
    ctx.fillText(`Signal: ${prediction.direction} | 100% Confirmed Target Extension`, 20, 55);
    ctx.fillStyle = '#aaaaaa';
    ctx.fillText(`Saved Memory Count: ${prediction.memoryMatches} occurrences`, 20, 75);

    ctx.strokeStyle = prediction.direction === 'BUY' ? '#00E676' : '#FF5252';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(50, 200);
    ctx.lineTo(150, 160);
    ctx.lineTo(250, 210);
    ctx.lineTo(350, 110);
    ctx.lineTo(450, 140);
    ctx.lineTo(550, prediction.direction === 'BUY' ? 70 : 250);
    ctx.stroke();

    return canvas.toDataURL();
  }
}

module.exports = new Executor();
