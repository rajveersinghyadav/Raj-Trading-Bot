const axios = require('axios');

class DataFetcher {
  constructor() {
    this.cache = new Map();
  }

  async fetchCandleAndVolume(asset) {
    try {
      // Fetching mock or live data stream matching timestamps, candle patterns, buyer/seller volume
      const timestamp = Date.now();
      const mockPrice = await this.getLivePrice(asset);
      const buyerVolume = Math.floor(Math.random() * 5000) + 1000;
      const sellerVolume = Math.floor(Math.random() * 5000) + 1000;
      
      const candleData = {
        asset,
        timestamp,
        open: mockPrice - (Math.random() * 2),
        high: mockPrice + (Math.random() * 5),
        low: mockPrice - (Math.random() * 5),
        close: mockPrice,
        buyerVolume,
        sellerVolume,
        pattern: buyerVolume > sellerVolume ? 'BULLISH_ENGULFING' : 'BEARISH_ENGULFING'
      };

      return candleData;
    } catch (error) {
      console.error(`Error fetching data for ${asset}:`, error.message);
      return null;
    }
  }

  async getLivePrice(asset) {
    // Base fallback/simulator for prices if external API is unreachable
    const basePrices = {
      BTCUSDT: 65000.00,
      ETHUSDT: 3500.00,
      EURUSD: 1.0920,
      GBPUSD: 1.2750,
      XAUUSD: 2350.00
    };
    const base = basePrices[asset] || 100.0;
    return base + (Math.random() * 10 - 5);
  }
}

module.exports = new DataFetcher();
