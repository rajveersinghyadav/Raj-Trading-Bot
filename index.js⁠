const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const dataFetcher = require('./market/dataFetcher');
const brain = require('./core/brain');
const executor = require('./execution/executor');
const config = require('./config');

const app = express();
const server = http.createServer(app);
const io = new Server(server);

app.use(express.json());

app.get('/', (req, res) => {
  res.send(`
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Raj Trading Bot - AI Market Predictor</title>
        <script src="https://cdn.socket.io/4.6.1/socket.io.min.js"></script>
        <style>
            body { font-family: Arial, sans-serif; background: #0b0e11; color: #f0f6fc; margin: 0; padding: 20px; }
            h1 { color: #00ffcc; text-align: center; }
            .container { max-width: 1200px; margin: auto; }
            .tv-container { width: 100%; height: 450px; background: #161a25; border-radius: 8px; display: flex; align-items: center; justify-content: center; border: 1px solid #30363d; margin-bottom: 20px;}
            table { width: 100%; border-collapse: collapse; background: #161a25; border-radius: 8px; overflow: hidden; }
            th, td { padding: 12px 15px; text-align: center; border-bottom: 1px solid #30363d; }
            th { background: #21262d; color: #00ffcc; }
            .chat-box { background: #161a25; padding: 15px; border-radius: 8px; margin-top: 20px; border: 1px solid #30363d; }
            input[type="text"] { width: 75%; padding: 10px; background: #0b0e11; border: 1px solid #30363d; color: #fff; border-radius: 4px; }
            button { padding: 10px 20px; background: #00ffcc; color: #0b0e11; border: none; font-weight: bold; border-radius: 4px; cursor: pointer; }
            .chat-logs { height: 180px; overflow-y: auto; margin-bottom: 10px; padding: 5px; border: 1px solid #30363d; background: #0b0e11; border-radius: 4px; }
            .buy { color: #00E676; font-weight: bold; }
            .sell { color: #FF5252; font-weight: bold; }
        </style>
    </head>
    <body>
        <div class="container">
            <h1>Raj Trading Bot - AI Self-Learning Market Predictor</h1>
            
            <div class="tv-container">
                <div class="tradingview-widget-container">
                  <div id="tradingview_chart"></div>
                  <script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
                  <script type="text/javascript">
                    new TradingView.widget({
                      "width": "100%",
                      "height": "450",
                      "symbol": "BINANCE:BTCUSDT",
                      "interval": "1",
                      "timezone": "Etc/UTC",
                      "theme": "dark",
                      "style": "1",
                      "locale": "en",
                      "toolbar_bg": "#f1f3f6",
                      "enable_publishing": false,
                      "container_id": "tradingview_chart"
                    });
                  </script>
                </div>
            </div>

            <h2>Live AI Signals & Dynamic Targets</h2>
            <table>
                <thead>
                    <tr>
                        <th>Asset Name</th>
                        <th>Entry Point</th>
                        <th>Target Point</th>
                        <th>SL Point (Stop Loss)</th>
                    </tr>
                </thead>
                <tbody id="signal-table">
                    <tr><td colspan="4">Loading continuous AI self-learning market ticks...</td></tr>
                </tbody>
            </table>

            <div class="chat-box">
                <h3>AI Chatbot & Visual Screenshot Feature</h3>
                <div class="chat-logs" id="chatLogs"><div>AI: Hello! Type any asset name (e.g. BTCUSDT, EURUSD, XAUUSD) to get live pattern screenshots, memory match counts, and volume breakdowns.</div></div>
                <input type="text" id="assetInput" placeholder="Enter asset name...">
                <button onclick="sendQuery()">Send to AI</button>
            </div>
        </div>

        <script>
            const socket = io();

            socket.on('marketUpdate', (data) => {
                const tbody = document.getElementById('signal-table');
                tbody.innerHTML = '';
                data.forEach(item => {
                    const row = document.createElement('tr');
                    const dirClass = item.direction === 'BUY' ? 'buy' : 'sell';
                    row.innerHTML = \`
                        <td>\${item.asset}</td>
                        <td class="\${dirClass}">\${item.entryPoint} (\${item.direction})</td>
                        <td style="color: #00ffcc; font-weight: bold;">\${item.targetPoint} 🚀</td>
                        <td>\${item.slPoint}</td>
                    \`;
                    tbody.appendChild(row);
                });
            });

            function sendQuery() {
                const asset = document.getElementById('assetInput').value.toUpperCase();
                if (!asset) return;
                const logs = document.getElementById('chatLogs');
                logs.innerHTML += \`<div><b>You:</b> \${asset}</div>\`;
                
                socket.emit('chatQuery', asset, (response) => {
                    logs.innerHTML += \`<div><b>AI:</b> \${response.reason} <br><b>Memory Count:</b> Saved \${response.memoryMatches} times.<br><b>Volume Breakdown:</b> Buyers: \${response.buyerVolume} | Sellers: \${response.sellerVolume}<br><img src="\${response.screenshot}" style="max-width:300px; margin-top:5px; border-radius:4px;"/></div>\`;
                    logs.scrollTop = logs.scrollHeight;
                });
                document.getElementById('assetInput').value = '';
            }
        </script>
    </body>
    </html>
  `);
});

io.on('connection', (socket) => {
  const interval = setInterval(async () => {
    const predictions = [];
    for (const asset of config.SUPPORTED_ASSETS) {
      const candle = await dataFetcher.fetchCandleAndVolume(asset);
      if (candle) {
        const analysis = brain.analyzeMarket(candle);
        predictions.push(analysis);
      }
    }
    socket.emit('marketUpdate', predictions);
  }, config.UPDATE_INTERVAL_MS);

  socket.on('chatQuery', async (asset, callback) => {
    const targetAsset = config.SUPPORTED_ASSETS.includes(asset) ? asset : 'BTCUSDT';
    const candle = await dataFetcher.fetchCandleAndVolume(targetAsset);
    const analysis = brain.analyzeMarket(candle);
    const screenshot = executor.generatePatternGraphScreenshot(targetAsset, analysis);

    callback({
      reason: analysis.reason,
      memoryMatches: analysis.memoryMatches,
      buyerVolume: analysis.buyerVolume,
      sellerVolume: analysis.sellerVolume,
      screenshot: screenshot
    });
  });

  socket.on('disconnect', () => {
    clearInterval(interval);
  });
});

server.listen(config.PORT, () => {
  console.log(`Server running on port ${config.PORT}`);
});
